{
  "name": "daybook-calendar",
  "productName": "Aurora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "description": "A local Windows calendar, alarms, and email-event inbox",
  "author": "Mikey",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "local.daybook.calendar",
    "productName": "Aurora",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "src/core/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/daybook.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "Aurora-${version}.exe"
    }
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@touch4it/ical-timezones": "^1.9.0",
    "chrono-node": "^2.10.3",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.66.0",
    "mailparser": "^3.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdav": "^2.5.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "vite": "^8.3.5"
  }
}
