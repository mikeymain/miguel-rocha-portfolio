{
	"browser_specific_settings": {
		"gecko": {
			"id": "travian-qol@travian-extensions.mikeymain"
		}
	},
	"manifest_version": 3,
	"name": "Travian QoL",
	"version": "1.7.11",
	"description": "Collection of small quality-of-life tweaks for Travian. Each feature is independently toggleable.",
	"permissions": ["storage", "contextMenus"],
	"host_permissions": [
		"*://*.travian.com/*",
		"*://*.travian.de/*",
		"*://*.travian.co.uk/*",
		"*://*.travian.us/*",
		"*://*.travian.net/*",
		"*://*.travian.fr/*",
		"*://*.travian.it/*",
		"*://*.travian.cz/*",
		"*://*.travian.pl/*",
		"*://*.travian.ru/*",
		"*://*.travian.tr/*",
		"*://*.travian.ae/*"
	],
	"background": {
		"service_worker": "background.js",
		"scripts": ["background.js"]
	},
	"icons": {
		"16": "icon16.png",
		"32": "icon32.png",
		"48": "icon48.png",
		"128": "icon128.png"
	},
	"action": {
		"default_title": "Travian QoL settings",
		"default_popup": "options/options.html",
		"default_icon": {
			"16": "icon16.png",
			"32": "icon32.png",
			"48": "icon48.png",
			"128": "icon128.png"
		}
	},
	"options_ui": {
		"page": "options/options.html",
		"open_in_tab": true
	},
	"content_scripts": [
		{
			"matches": [
				"*://*.travian.com/*",
				"*://*.travian.de/*",
				"*://*.travian.co.uk/*",
				"*://*.travian.us/*",
				"*://*.travian.net/*",
				"*://*.travian.fr/*",
				"*://*.travian.it/*",
				"*://*.travian.cz/*",
				"*://*.travian.pl/*",
				"*://*.travian.ru/*",
				"*://*.travian.tr/*",
				"*://*.travian.ae/*"
			],
			"js": [
				"lib/registry.js",
				"features/farmlist-multi-select/index.js",
				"features/farmlist-bounty-sort/index.js",
				"features/farmlist-raid-fill/core.js",
				"features/farmlist-raid-fill/index.js",
				"features/farmlist-oasis-kills/core.js",
				"features/farmlist-oasis-kills/index.js",
				"features/farmlist-edit-chooser/index.js",
				"features/adventure-sort/index.js",
				"features/village-resource-total/index.js",
				"features/report-opener/index.js",
				"features/loot-calc/index.js",
				"features/todolist/index.js",
				"features/upgrade-values/index.js",
				"features/build-order/core.js",
				"features/build-order/guide-4p.js",
				"features/build-order/index.js",
				"features/smithy-efficiency/core.js",
				"features/smithy-efficiency/index.js",
				"features/resource-full-time/index.js",
				"features/trade-route-production/core.js",
				"features/trade-route-production/index.js",
				"content.js"
			],
			"css": ["features/loot-calc/styles.css"],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"*://*.travian.com/*",
				"*://*.travian.de/*",
				"*://*.travian.co.uk/*",
				"*://*.travian.us/*",
				"*://*.travian.net/*",
				"*://*.travian.fr/*",
				"*://*.travian.it/*",
				"*://*.travian.cz/*",
				"*://*.travian.pl/*",
				"*://*.travian.ru/*",
				"*://*.travian.tr/*",
				"*://*.travian.ae/*"
			],
			"js": ["features/trade-route-production/core.js", "features/trade-route-production/early.js"],
			"run_at": "document_start"
		}
	]
}
