{
	"browser_specific_settings": {
		"gecko": {
			"id": "travalarm@travian-extensions.mikeymain"
		}
	},
	"manifest_version": 3,
	"key": "",
	"name": "TravAlarm",
	"version": "3.70",
	"description": "Get incoming attack alerts and track Travian building, troop training and research timers, plus custom reminders.",
	"permissions": [
		"notifications",
		"alarms",
		"storage",
		"contextMenus",
		"offscreen",
		"idle"
	],
	"host_permissions": ["*://*.travian.com/*"],
	"background": {
		"service_worker": "background.js",
		"scripts": ["attack-state.js", "offscreen.js", "background.js"]
	},
	"action": {
		"default_title": "TravAlarm",
		"default_popup": "popup.html"
	},
	"icons": {
		"16": "icon16.png",
		"32": "icon32.png",
		"48": "icon.png",
		"128": "icon128.png"
	},
	"content_scripts": [
		{
			"matches": ["*://*.travian.com/*"],
			"exclude_matches": [
				"*://*.travian.com/international*",
				"*://*.travian.com/uk/calendar*",
				"*://*.travian.com/account*"
			],
			"js": [
				"state.js",
				"icons.js",
				"helpers.js",
				"fetchers.js",
				"deliveries.js",
				"scanners.js",
				"instant-finish.js",
				"world-timers.js",
				"layout.js",
				"ui.js",
				"server-ignore.js",
				"content.js"
			],
			"css": ["content.css"],
			"run_at": "document_end"
		}
	]
}
