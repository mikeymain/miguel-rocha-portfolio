{
	"browser_specific_settings": {
		"gecko": {
			"id": "world-watch@travian-extensions.mikeymain"
		}
	},
	"manifest_version": 3,
	"name": "Travian World Watch",
	"version": "1.7.9",
	"devtools_page": "map-capture.html",
	"description": "Tracks a world's public map.sql over time: spawn ring, population gains and alliances.",
	"permissions": ["storage", "alarms", "unlimitedStorage"],
	"host_permissions": [
		"https://*.travian.com/map.sql",
		"https://*.travian.org/map.sql",
		"https://*.travian.net/map.sql",
		"https://*.travian.us/map.sql",
		"https://*.travian.de/map.sql"
	],
	"background": {
		"service_worker": "background.js",
		"scripts": ["lib/mapsql.js", "lib/db.js", "lib/core.js", "lib/croppers.js", "background.js"]
	},
	"content_scripts": [
		{
			"matches": ["https://*.travian.com/map*", "https://*.travian.org/map*", "https://*.travian.net/map*", "https://*.travian.us/map*", "https://*.travian.de/map*", "https://*.travian.com/karte.php*", "https://*.travian.org/karte.php*", "https://*.travian.net/karte.php*", "https://*.travian.us/karte.php*", "https://*.travian.de/karte.php*"],
			"exclude_matches": ["https://ts1.x1.europe.travian.com/*"],
			"js": ["cropper-collector.js"],
			"run_at": "document_idle"
		},
		{
			"matches": ["https://*.travian.com/*", "https://*.travian.org/*", "https://*.travian.net/*", "https://*.travian.us/*", "https://*.travian.de/*"],
			"js": ["own-village.js"],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_popup": "popup.html",
		"default_title": "World Watch",
		"default_icon": {
			"16": "icon16.png",
			"32": "icon32.png",
			"48": "icon48.png",
			"128": "icon128.png"
		}
	},
	"icons": {
		"16": "icon16.png",
		"32": "icon32.png",
		"48": "icon48.png",
		"128": "icon128.png"
	}
}
