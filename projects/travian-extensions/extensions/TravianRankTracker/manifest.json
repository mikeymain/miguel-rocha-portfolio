{
	"manifest_version": 3,
	"name": "Travian Rank Tracker",
	"version": "5.0.27",
	"description": "Tracks weekly Top 10, general rankings and history graphs.",
	"permissions": [
		"storage",
		"alarms",
		"activeTab",
		"scripting",
		"unlimitedStorage",
		"downloads"
	],
	"host_permissions": [
		"*://*.travian.com/*",
		"*://*.travian.org/*",
		"*://*.travian.net/*",
		"*://*.travian.us/*",
		"*://*.travian.de/*"
	],
	"background": {
		"service_worker": "background.js",
		"scripts": ["utils.js", "background.js"]
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "Rank Tracker",
		"default_icon": {
			"16": "icon128.png",
			"32": "icon128.png",
			"48": "icon128.png",
			"128": "icon128.png"
		}
	},
	"icons": {
		"16": "icon128.png",
		"32": "icon128.png",
		"48": "icon128.png",
		"128": "icon128.png"
	},
	"content_scripts": [
		{
			"matches": ["*://*.travian.com/*", "*://*.travian.org/*", "*://*.travian.net/*", "*://*.travian.us/*", "*://*.travian.de/*"],
			"js": ["raid-income-bridge.js"],
			"run_at": "document_end"
		}
	]
}
