{
	"manifest_version": 3,
	"name": "Travian Dark Mod",
	"version": "2.7.2",
	"description": "Unofficial dark theme for Travian: Legends, with an on/off toggle and custom button colours.",
	"author": "Miguel Rocha",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"permissions": ["storage"],
	"host_permissions": [
		"*://*.travian.com/*",
		"*://*.travian.de/*",
		"*://*.travian.us/*",
		"*://*.travian.fr/*",
		"*://*.travian.it/*",
		"*://*.travian.cz/*",
		"*://*.travian.pl/*",
		"*://*.travian.ru/*",
		"*://*.travian.tr/*",
		"*://*.travian.ae/*",
		"*://*.travian.net/*",
		"*://*.travian.co.uk/*"
	],
	"action": {
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png"
		},
		"default_popup": "popup.html"
	},
	"content_scripts": [
		{
			"matches": [
				"*://*.travian.com/*",
				"*://*.travian.de/*",
				"*://*.travian.us/*",
				"*://*.travian.fr/*",
				"*://*.travian.it/*",
				"*://*.travian.cz/*",
				"*://*.travian.pl/*",
				"*://*.travian.ru/*",
				"*://*.travian.tr/*",
				"*://*.travian.ae/*",
				"*://*.travian.net/*",
				"*://*.travian.co.uk/*"
			],
			"js": ["content.js"],
			"run_at": "document_start"
		}
	]
}
