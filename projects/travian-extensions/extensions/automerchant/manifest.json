{
	"manifest_version": 3,
	"name": "Travian NPC AutoMerchant",
	"version": "3.2.17",
	"description": "NPC resource helper with troop calculator, ratio distribution, and auto-tribe detection for Travian.",
	"author": "Miguel Rocha",
	"icons": {
		"16": "icon16.png",
		"32": "icon32.png",
		"48": "icon.png",
		"128": "icon128.png"
	},
	"permissions": ["storage"],
	"content_scripts": [
		{
			"matches": ["*://*.travian.com/*"],
			"js": [
				"config.js",
				"utils.js",
				"tribe-detector.js",
				"resource-parser.js",
				"observers.js",
				"hero-puller.js",
				"npc-lock.js",
				"slider-drag.js",
				"ui.js",
				"main.js"
			],
			"css": ["styles.css"],
			"run_at": "document_end"
		},
		{
			"matches": ["*://*.travian.com/*"],
			"js": ["hero-bridge.js"],
			"world": "MAIN",
			"run_at": "document_end"
		}
	]
}
