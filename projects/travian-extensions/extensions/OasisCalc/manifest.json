{
  "browser_specific_settings": {
    "gecko": {
      "id": "oasis-finder@travian-extensions.mikeymain"
    }
  },
  "manifest_version": 3,
  "name": "Travian Best Oasis Finder",
  "version": "70.27",
  "description": "Oasis scoring and farm-list sorting for Travian.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon.png",
    "128": "icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.travian.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "externally_connectable": {
    "ids": ["kglfeknoojikombokgbemggkllbfkjgj"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.travian.com/karte.php*", "*://*.travian.com/map*"],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.travian.com/karte.php*", "*://*.travian.com/map*"],
      "js": [
        "constants.js",
        "utils.js",
        "bridge.js",
        "coverage.js",
        "storage.js",
        "db-view.js",
        "hero-sync.js",
        "ui.js",
        "scanner.js",
        "analyzer.js",
        "clear-calc.js",
        "main.js"
      ],
      "css": ["oasis_finder.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.travian.com/build.php*", "*://*.travian.com/building*"],
      "js": ["constants.js", "farmlist.js"],
      "css": ["farmlist.css"],
      "run_at": "document_idle"
    }
  ]
}
