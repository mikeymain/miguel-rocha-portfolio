# Personal state, not part of the app.
# (Git has no trailing comments — patterns must be alone on their line.)

# contains your PIN
config.json

# your own hotkey layout; defaults live in store.py
hotkeys.json

__pycache__/
*.pyc

# paired phones (token hashes)
devices.json
.pytest_cache/

# left behind if the server stops mid-write; may hold the PIN or token hashes
*.json.tmp
